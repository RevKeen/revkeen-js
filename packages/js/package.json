{
  "name": "@revkeen/js",
  "version": "0.1.0-beta.0",
  "description": "RevKeen browser client: carts and storefront products with a publishable key (rk_pk_*). For server code and secret keys, use @revkeen/sdk.",
  "license": "MIT",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RevKeen/revkeen-js.git",
    "directory": "packages/js"
  },
  "keywords": [
    "revkeen",
    "cart",
    "checkout",
    "storefront",
    "browser"
  ]
}
