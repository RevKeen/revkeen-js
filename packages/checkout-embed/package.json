{
  "name": "@revkeen/checkout-embed",
  "version": "0.1.0-beta.0",
  "description": "Thin loader for the RevKeen embeddable Direct Debit capture surface. Injects the CDN-hosted bundle — never self-host (Stripe.js model).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RevKeen/revkeen-js.git",
    "directory": "packages/checkout-embed"
  },
  "sideEffects": false
}
